# ============================================================
# Vera Carat Jewels - Etsy to Pinterest Daily Scheduler Config
# ============================================================

# --- Etsy API Configuration ---
# Your Etsy Shop ID or Shop Name (e.g., VeraCaratJewel)
ETSY_SHOP_ID=VeraCaratJewel
# Etsy Open API v3 Key (Keystring)
ETSY_API_KEY=your_etsy_api_key_here
# Etsy OAuth 2.0 Access Token
ETSY_ACCESS_TOKEN=your_etsy_access_token_here

# --- Pinterest API Configuration ---
# Pinterest API v5 OAuth Bearer Token (requires: pins:write, boards:read)
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here
# Destination Pinterest Board ID where pins will be saved
PINTEREST_BOARD_ID=your_pinterest_board_id_here

# --- Scheduler Settings ---
# Daily Cron Expression (Default: "0 10 * * *" = everyday at 10:00 AM)
SCHEDULE_CRON=0 10 * * *
# Timezone for the scheduler (e.g., Asia/Kolkata, America/New_York)
TZ=Asia/Kolkata

# Pins to create per product (Default: 5)
PINS_PER_PRODUCT=5

# Interval in minutes between each of the 5 pins (0 = post all 5 at once, 60 = stagger every hour)
PIN_INTERVAL_MINUTES=30

# Dry Run Mode: set to "true" to simulate posting without calling Pinterest API
DRY_RUN=true
